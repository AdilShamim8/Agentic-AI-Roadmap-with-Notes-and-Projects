# Solution 07 (anomaly monitor) environment template.
# Copy to .env and fill in. All vars optional; see docs/deployment.md.

# --- LLM (optional; the ensemble works without it) ---
ANOMON_LLM_PROVIDER=none          # none | openai
ANOMON_LLM_MODEL=gpt-5.5
OPENAI_API_KEY=

# --- Core ---
ANOMON_STATE_BACKEND=memory       # memory | redis
ANOMON_REDIS_URL=redis://localhost:6379/0

# --- Streaming ---
ANOMON_STREAM_SOURCE=synthetic    # synthetic | file | kafka
ANOMON_KAFKA_BROKERS=localhost:9092
ANOMON_KAFKA_TOPIC=metrics

# --- Windowing / detection ---
ANOMON_WINDOW_SECONDS=300
ANOMON_DETECTION_STRATEGY=ensemble

# --- Response policy ---
ANOMON_AUTO_THRESHOLD=0.7
ANOMON_HITL_ENABLED=true
