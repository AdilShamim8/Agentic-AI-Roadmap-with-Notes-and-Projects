# Self-hosting note (Oct 2026): production images are generated by
# `langgraph build` from langgraph.json - there is no prebuilt base image
# to hand-write a Dockerfile around anymore. This file exists for the
# docker-compose dev stack in this folder.
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY examples/ ./examples/
RUN pip install --no-cache-dir -e . "langgraph-cli[all]>=0.4.36"

EXPOSE 8000
CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "8000", "--no-browser"]
