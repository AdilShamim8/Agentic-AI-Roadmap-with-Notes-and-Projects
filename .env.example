# agentic-ai-roadmap environment template.
# Copy to `.env` and fill in the keys you have. Every variable is
# optional except where noted; demos degrade gracefully without keys.

# --- LLM providers (examples default to Anthropic) -----------------------
# Required by demos that construct an LLM (react, conversational,
# structured_output, llm_judge). CI runs without any key.
ANTHROPIC_API_KEY=

# Optional second provider for cross-provider demos.
OPENAI_API_KEY=

# Model overrides. Defaults are long-lifecycle models; see the examples
# docstrings. Provider pricing pages, not this file, are the source of
# truth for cost.
EXAMPLES_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-haiku-5-5

# --- Observability -------------------------------------------------------
# LangSmith tracing (module 06). Traces appear only when the key is set.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=agentic-ai-roadmap

# --- Deployment ----------------------------------------------------------
# Self-hosted checkpointer (module 08). Unset = SqliteSaver in the demos.
# POSTGRES_URL=postgresql://user:pass@localhost:5432/langgraph
